#!{{PREFIX}}/bin/sh
# 与 kiwix-serve 相同，但默认只监听 127.0.0.1（上游默认是 --address=all，会监听 0.0.0.0）。
# 用户自己显式写了 -i / --address 时照用户的来。
for a in "$@"; do
  case "$a" in
    --address|--address=*|-i|-i?*) exec "{{PREFIX}}/bin/kiwix-serve" "$@" ;;
  esac
done
exec "{{PREFIX}}/bin/kiwix-serve" --address=127.0.0.1 "$@"
