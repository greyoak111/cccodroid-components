#!{{PREFIX}}/bin/sh
# 与 kiwix-serve 相同，但默认只监听 127.0.0.1（上游默认是 --address=all，会监听 0.0.0.0）。
# 用户自己显式写了 -i / --address、或无参/仅查帮助版本时直接原样透传（docopt 不接受在 -h/-V 前加选项）。
[ $# -eq 0 ] && exec "{{PREFIX}}/bin/kiwix-serve"
for a in "$@"; do
  case "$a" in
    --) break ;;
    --address|--address=*|-i|-i?*|-h|--help|-V|--version) exec "{{PREFIX}}/bin/kiwix-serve" "$@" ;;
  esac
done
exec "{{PREFIX}}/bin/kiwix-serve" --address=127.0.0.1 "$@"
