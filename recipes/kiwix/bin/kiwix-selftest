#!{{PREFIX}}/bin/sh
# kiwix 自检：三个命令都能启动，且 libkiwix / libzim / libicu 79 能正常加载。
# 没有可再分发的小 ZIM，所以不打开真实知识库；只验证本组件和它的库链。
set -u
PREFIX="{{PREFIX}}"
fail=0
bad() { printf '✗ %s\n' "$*"; fail=1; }

v1=$("$PREFIX/bin/kiwix-serve" --version 2>&1)
if [ $? -eq 0 ] && [ -n "$v1" ]; then
  echo "kiwix-serve: OK  ($(printf '%s' "$v1" | head -1))"
else
  bad "kiwix-serve --version 失败：$(printf '%s' "$v1" | head -3)"
fi

v2=$("$PREFIX/bin/kiwix-manage" --version 2>&1)
if [ $? -eq 0 ] && [ -n "$v2" ]; then
  echo "kiwix-manage: OK  ($(printf '%s' "$v2" | head -1))"
else
  bad "kiwix-manage --version 失败：$(printf '%s' "$v2" | head -3)"
fi

# kiwix-search 没有 --version；不带参数时应打印用法并正常加载库（缺库会 CANNOT LINK EXECUTABLE）
v3=$("$PREFIX/bin/kiwix-search" 2>&1)
case "$v3" in
  *CANNOT\ LINK*|*cannot\ locate*) bad "kiwix-search 加载失败：$(printf '%s' "$v3" | head -2)" ;;
  *) echo "kiwix-search: OK  (usage printed)" ;;
esac

[ -x "$PREFIX/bin/kiwix-serve-local" ] || bad "kiwix-serve-local 不可执行"

if [ "$fail" -ne 0 ]; then
  echo "===== 总结 ===== kiwix FAIL"
  exit 1
fi
echo "===== 总结 ===== kiwix-serve=$(printf '%s' "$v1" | head -1 | awk '{print $NF}') kiwix-manage=$(printf '%s' "$v2" | head -1 | awk '{print $NF}') kiwix-search=OK"
